# Atlas Plane local environment
# Fill these values before running: go run . serve

PROXMOX_API_TOKEN=
PROXMOX_URL=
PROXMOX_NODE=

# Optional overrides
# TEMPLATE_VMID=9000
# VM_CORES=2
# VM_MEMORY=2048
# VM_DISK_SIZE=20G
# CA_KEY_PATH=./ca_ed25519
# CA_KEY_PATH=/run/secrets/ca_ed25519
# ATLAS_SSH_KEY_DIR=./.atlas/keys
# MASTER_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# SNIPPET_STORAGE=local
# SNIPPET_DIR=/var/lib/vz/snippets
# PVE_SSH_USER=root
# PVE_SSH_KEY=~/.ssh/id_rsa
# PVE_SSH_KEY=/app/pve_ssh_key
# PVE_SSH_PORT=22
# ATLAS_WEB_PORT=8080
# ATLAS_AUTH_ENABLED=false
# Optional: preconfigure users. If omitted, first login bootstraps admin password in UI.
# ATLAS_AUTH_USERS=viewer|viewer|viewer-pass;ops|operator|ops-pass;admin|admin|admin-pass
# ATLAS_AUTH_STORE_PATH=./.atlas/auth/users.json
# ATLAS_AUTH_STORE_PATH=/auth/users.json   # Recommended when running via Docker Compose with auth_data volume
# ATLAS_AUTH_SESSION_TTL_MINUTES=480
# ATLAS_AUTH_LOGIN_MAX_ATTEMPTS=5
# ATLAS_AUTH_LOGIN_WINDOW_MINUTES=15
