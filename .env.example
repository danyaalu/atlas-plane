# Atlas Plane local environment
# 1. Update PROXMOX_* variables with your Proxmox details
# 2. Generate MASTER_ENCRYPTION_KEY (see README.md "Quick Start" section):
#    openssl rand -hex 32
# 3. Then run: go run . serve

# Required: Proxmox API authentication
PROXMOX_API_TOKEN=root@pam!atlas=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
PROXMOX_URL=https://192.168.1.100:8006
PROXMOX_NODE=pve

# Required: Encryption key for storing SSH private keys (32 bytes)
# Generate: openssl rand -hex 32
MASTER_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Optional: VM template and provisioning defaults
# TEMPLATE_VMID=9000
# VM_CORES=2
# VM_MEMORY=2048
# VM_DISK_SIZE=20G
# VM_COUNT=1

# Optional: SSH CA key path
# CA_KEY_PATH=./ca_ed25519
# CA_KEY_PATH=/run/secrets/ca_ed25519

# Optional: Key vault location
# ATLAS_SSH_KEY_DIR=./.atlas/keys

# Optional: Proxmox snippet storage (for Cloud-Init injection)
# SNIPPET_STORAGE=local
# SNIPPET_DIR=/var/lib/vz/snippets

# Optional: SSH access to Proxmox host
# PVE_SSH_USER=root
# PVE_SSH_KEY=~/.ssh/id_rsa
# PVE_SSH_KEY=/app/pve_ssh_key
# PVE_SSH_PORT=22

# Optional: Web UI and authentication
# ATLAS_WEB_PORT=8080
# ATLAS_AUTH_ENABLED=false
# Preconfigure users (format: username|role|password; roles: viewer, operator, admin)
# ATLAS_AUTH_USERS=viewer|viewer|viewer-pass;ops|operator|ops-pass;admin|admin|admin-pass
# ATLAS_AUTH_STORE_PATH=./.atlas/auth/users.json
# ATLAS_AUTH_STORE_PATH=/auth/users.json   # Use with Docker Compose auth_data volume
# ATLAS_AUTH_SESSION_TTL_MINUTES=480
# ATLAS_AUTH_LOGIN_MAX_ATTEMPTS=5
# ATLAS_AUTH_LOGIN_WINDOW_MINUTES=15
